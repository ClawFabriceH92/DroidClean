<?xml version="1.0" encoding="utf-8"?>
<!--
  Palette du mode clair. Toute couleur définie ici DOIT avoir sa contrepartie
  dans values-night/colors.xml : le thème est DayNight, donc les composants
  Material basculent tout seuls — si les couleurs de texte, elles, restent
  codées pour le mode clair, on obtient du texte sombre sur une carte sombre.
-->
<resources>
    <color name="brand">#FF1A73E8</color>
    <color name="brand_dark">#FF1557B0</color>
    <color name="on_brand">#FFFFFFFF</color>
    <color name="accent">#FF34A853</color>
    <color name="accent_dark">#FF2E7D32</color>
